{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/publisher-mapping.schema.json",
  "title": "Publisher project mapping version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mapping_id", "project_id", "organization_id", "workspace_id", "api_credential_id", "approval", "brands"],
  "properties": {
    "schema_version": {"const": 1},
    "mapping_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "project_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "api_credential_id": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "binds_content_hash"],
      "properties": {
        "required": {"const": true},
        "binds_content_hash": {"const": true}
      }
    },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brand_id", "account_ids"],
        "properties": {
          "brand_id": {"type": "string", "minLength": 1},
          "account_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
