# Agent-isolation worktrees (scripts/new-worktree.sh). Each lives on its own
# branch and is removed via scripts/rm-worktree.sh once merged.
.worktrees/

# Per-worktree lane metadata written by scripts/new-worktree.sh
.dholbeat-agent
.git-commit-template

# Secrets — .env is always forbidden. Public templates contain names only.
.env
.env.*
!.env.example
!*.env.example
*.key
*.pem
credentials*.json

# Only values-only SOPS ciphertext plus non-secret catalog/docs may be tracked
# below infra/secrets/. Private age keys stay in the password manager.
infra/secrets/**
!infra/secrets/**/
!infra/secrets/README.md
!infra/secrets/catalog.yml
!infra/secrets/**/*.sops.yml

# Read-only check output and bounded controller-local caches.
.artifacts/
.controller-cache/

# Generated / ephemeral media: purge after publish, never committed.
media/
out/
*.mp4
*.mov
*.png
*.jpg
*.jpeg
!docs/**/*.png

# n8n runtime data (only exported flow JSON under n8n/ is committed)
stack/data/
n8n/.cache/

# OpenTofu working state and generated plans are never repository inputs.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan

# Restored databases and recovery scratch data.
restores/
backups/
*.db
*.dump
*.sqlite
*.sqlite3

# Tooling noise
node_modules/
__pycache__/
.venv/
.DS_Store
*.log
