{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/release.schema.json",
  "title": "Release receipt version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "release_id", "git_commit", "tag", "created_at", "author", "review", "toolchain_lock_sha256", "target_roles", "approved_plan_sha256", "required_backup_snapshot_id", "schema_versions", "images"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_type": {"const": "release"},
    "release_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": "string", "pattern": "^infra-prod-[0-9]{8}-[0-9]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "author": {"enum": ["codex", "claude-code"]},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_commit", "verdict"],
      "properties": {
        "reviewer": {"enum": ["codex", "claude-code"]},
        "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verdict": {"const": "approved"}
      }
    },
    "toolchain_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_roles": {"type": "array", "minItems": 1, "items": {"enum": ["core", "publisher", "fixture"]}, "uniqueItems": true},
    "approved_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_backup_snapshot_id": {"type": "string", "minLength": 1},
    "schema_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_id", "digest"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
