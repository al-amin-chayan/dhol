{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/route.schema.json",
  "title": "Public route registry version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "service_id", "host_id", "domain_id", "path", "caller", "access", "allowed_methods", "origin", "application_auth", "rate_limit", "data_classification", "retention_owner", "negative_probes", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "service_id": {"type": "string", "minLength": 1},
          "host_id": {"type": "string", "minLength": 1},
          "domain_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^/"},
          "caller": {"enum": ["human", "machine"]},
          "access": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "policy_id"],
            "properties": {
              "mode": {"enum": ["enforced", "machine-exception"]},
              "policy_id": {"type": "string", "minLength": 1}
            }
          },
          "allowed_methods": {"type": "array", "minItems": 1, "items": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]}, "uniqueItems": true},
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "host", "port"],
            "properties": {
              "scheme": {"enum": ["http", "https"]},
              "host": {"type": "string", "minLength": 1},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          },
          "application_auth": {"type": "string", "minLength": 1},
          "rate_limit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requests", "period_seconds"],
            "properties": {
              "requests": {"type": "integer", "minimum": 1},
              "period_seconds": {"type": "integer", "minimum": 1}
            }
          },
          "data_classification": {"enum": ["public", "internal", "confidential", "pii"]},
          "retention_owner": {"type": "string", "minLength": 1},
          "negative_probes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
