{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/secret-catalog.schema.json",
  "title": "Secret catalog version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secrets"],
  "properties": {
    "schema_version": {"const": 1},
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner_project_id", "allowed_service_ids", "allowed_project_ids", "purpose", "rotation_trigger", "recovery_location", "target_host_file"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "owner_project_id": {"type": "string", "minLength": 1},
          "allowed_service_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "allowed_project_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "purpose": {"type": "string", "minLength": 1},
          "rotation_trigger": {"type": "string", "minLength": 1},
          "recovery_location": {"type": "string", "minLength": 1},
          "target_host_file": {"type": "string", "pattern": "^/"}
        }
      }
    }
  }
}
