{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/secret-catalog.schema.json",
  "title": "Secret catalog version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secrets"],
  "properties": {
    "schema_version": {"const": 1},
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner_project_id", "allowed_principal_ids", "allowed_service_ids", "allowed_project_ids", "purpose", "sops_file", "value_key", "rotation", "recovery_account", "target"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "owner_project_id": {"type": "string", "minLength": 1},
          "allowed_principal_ids": {
            "description": "Binding allow-list for every service, brand, workflow, consumer, Hermes project, or publisher mapping that may resolve this secret.",
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "allowed_service_ids": {
            "description": "Binding service-only subset of allowed_principal_ids; empty when no service consumes this secret.",
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "allowed_project_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "purpose": {"type": "string", "minLength": 1},
          "sops_file": {
            "type": "string",
            "pattern": "^infra/secrets/(?:[a-z0-9][a-z0-9-]*/)*[a-z0-9][a-z0-9-]*\\.sops\\.yml$"
          },
          "value_key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "rotation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["triggers", "procedure", "rotate_value_on_recipient_leak"],
            "properties": {
              "triggers": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              },
              "procedure": {"type": "string", "minLength": 1},
              "rotate_value_on_recipient_leak": {"const": true}
            }
          },
          "recovery_account": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "location", "owner"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
              "location": {"const": "password-manager"},
              "owner": {"type": "string", "minLength": 1}
            }
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "host_id", "path", "mode", "variable"],
                "properties": {
                  "kind": {"const": "host-file"},
                  "host_id": {"type": "string", "minLength": 1},
                  "path": {"type": "string", "pattern": "^/"},
                  "mode": {"const": "0600"},
                  "variable": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {"kind": {"const": "controller-memory"}}
              }
            ]
          }
        }
      }
    }
  }
}
