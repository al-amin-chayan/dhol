{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/secret-values.schema.json",
  "title": "Decrypted SOPS secret values version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secret_set_id", "owner_project_id", "values"],
  "properties": {
    "schema_version": {"const": 1},
    "secret_set_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "owner_project_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
