{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/domain.schema.json",
  "title": "Domain registry version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domains"],
  "properties": {
    "schema_version": {"const": 1},
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "registrar_owner", "expected_nameservers", "renewal_owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"},
          "registrar_owner": {"type": "string", "minLength": 1},
          "expected_nameservers": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "renewal_owner": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
