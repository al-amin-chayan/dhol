FROM python:3.13.7-slim-bookworm@sha256:adafcc17694d715c905b4c7bebd96907a1fd5cf183395f0ebc4d3428bd22d92d

ARG TARGETARCH
ARG CONTROLLER_LOCK_DIGEST

LABEL org.opencontainers.image.title="Dholbeat repository controller" \
      org.opencontainers.image.source="https://github.com/al-amin-chayan/dhol" \
      io.dholbeat.controller.cache="wp00-v1" \
      io.dholbeat.controller.lock="${CONTROLLER_LOCK_DIGEST}"

ENV ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    ANSIBLE_LOCAL_TEMP=/tmp/ansible-local \
    ANSIBLE_REMOTE_TEMP=~/.ansible/tmp \
    HOME=/tmp/controller-home \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY infra/controller/requirements.txt /tmp/controller-requirements.txt
RUN python -m pip install --require-hashes --no-deps -r /tmp/controller-requirements.txt

COPY toolchain.lock.yml /opt/dholbeat/toolchain.lock.yml
COPY infra/controller/install_tools.py /opt/dholbeat/install_tools.py
RUN mkdir -p "${HOME}" "${ANSIBLE_LOCAL_TEMP}" \
    && python /opt/dholbeat/install_tools.py \
      --lock /opt/dholbeat/toolchain.lock.yml \
      --arch "${TARGETARCH}" \
    && python -m pip check

COPY infra/controller/runtime_versions.py /opt/dholbeat/runtime_versions.py
COPY infra/controller/entrypoint.sh /usr/local/bin/controller-entrypoint
RUN chmod 0755 /usr/local/bin/controller-entrypoint \
    && mkdir -p /workspace \
    && python /opt/dholbeat/runtime_versions.py --verify-only

WORKDIR /workspace
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/controller-entrypoint"]
CMD ["versions"]
