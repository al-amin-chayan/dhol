#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
# shellcheck source=scripts/lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

REPO_ROOT="$(dholbeat_repo_root "$SCRIPT_PATH")"
REPO_ROOT="$(CDPATH='' cd -- "$REPO_ROOT" && pwd -P)"
LOCK_FILE="$REPO_ROOT/toolchain.lock.yml"
SOURCE_INPUTS=(
  toolchain.lock.yml
  infra/controller/Containerfile
  infra/controller/entrypoint.sh
  infra/controller/install_tools.py
  infra/controller/requirements.in
  infra/controller/requirements.txt
  infra/controller/requirements.yml
  infra/controller/runtime_versions.py
)

LOCAL_IMAGE="$(dholbeat_yaml_scalar "$LOCK_FILE" controller.local_image)"
BUILDKIT_IMAGE="$(dholbeat_yaml_scalar "$LOCK_FILE" controller.buildkit_image)"
CACHE_LABEL="$(dholbeat_yaml_scalar "$LOCK_FILE" controller.cache_label)"
CACHE_VALUE="$(dholbeat_yaml_scalar "$LOCK_FILE" controller.cache_value)"
MAX_CACHE_BYTES="$(dholbeat_yaml_scalar "$LOCK_FILE" controller.max_cache_bytes)"
LOCK_DIGEST="$(dholbeat_sha256_files "$REPO_ROOT" "${SOURCE_INPUTS[@]}")"
IMAGE_TAG="${LOCAL_IMAGE}:lock-${LOCK_DIGEST:0:16}"
ACTIVE_BUILDER=""
NETWORKED_HOME=""

usage() {
  cat <<'EOF'
Usage: scripts/controller <command> [arguments]

Commands:
  build                              build the locked native-architecture image
  versions                           verify and print normalized tool versions
  exec <command> [arguments]         run a command in the read-only controller
  exec-ssh --known-hosts .artifacts/<file> [--identity <path>]
       [--admin-identity <path>] [--inputs <directory>]
       --confirm disposable-host|production-host
       <command> [arguments]         run against a founder-approved SSH target
                                     with strict host-key checking. --identity
                                     mounts one private key at
                                     /tmp/controller-home/.ssh/id_target,
                                     --admin-identity mounts the administrator
                                     key at /tmp/controller-home/.ssh/id_admin,
                                     and --inputs mounts one read-only operator
                                     directory at /tmp/controller-inputs.
  digest                             print the source lock and local OCI image ID
  cache size                         report labelled controller image usage
  cache cleanup --confirm dholbeat-controller
                                     remove only unused labelled controller images
  help                               show this help

The command resolves the repository root from its own path, so it is safe to
invoke from any current directory. Host Docker/buildx is only the bootstrap;
all repository tools run from the checksum-locked controller image.
EOF
}

cleanup_builder() {
  if [ -n "$ACTIVE_BUILDER" ]; then
    docker buildx rm "$ACTIVE_BUILDER" >/dev/null 2>&1 || true
    ACTIVE_BUILDER=""
  fi
}

cleanup_networked_home() {
  if [ -z "$NETWORKED_HOME" ]; then
    return
  fi
  case "$NETWORKED_HOME" in
    */dholbeat-controller-home.*) rm -rf -- "$NETWORKED_HOME" ;;
    *) printf 'refusing unsafe controller-home cleanup target: %s\n' "$NETWORKED_HOME" >&2 ;;
  esac
  NETWORKED_HOME=""
}

cleanup() {
  cleanup_builder
  cleanup_networked_home
}
trap cleanup EXIT INT TERM

finish_builder() {
  local builder="$ACTIVE_BUILDER"
  [ -n "$builder" ] || dholbeat_die "no active controller builder to finish"
  docker buildx rm "$builder" >/dev/null || dholbeat_die "failed to remove dedicated builder: $builder"
  ACTIVE_BUILDER=""
}

host_platform() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s\n' linux/amd64 ;;
    arm64|aarch64) printf '%s\n' linux/arm64 ;;
    *) dholbeat_die "unsupported controller architecture: $(uname -m)" ;;
  esac
}

image_ids() {
  docker image ls \
    --filter "label=${CACHE_LABEL}=${CACHE_VALUE}" \
    --format '{{.ID}}' | sort -u
}

project_builder_names() {
  docker ps -a \
    --filter 'label=com.docker.buildx.builder' \
    --format '{{.Label "com.docker.buildx.builder"}}' | \
    awk '/^dholbeat-controller-[0-9a-f]+-[0-9]+$/'
}

cache_size_bytes() {
  local total=0
  local image_id
  while IFS= read -r image_id; do
    [ -n "$image_id" ] || continue
    total=$((total + $(docker image inspect --format '{{.Size}}' "$image_id")))
  done <<EOF
$(image_ids)
EOF
  printf '%s\n' "$total"
}

cache_size() {
  dholbeat_require_command docker
  local total
  local builders
  total="$(cache_size_bytes)"
  builders="$(project_builder_names)"
  printf 'controller images: %s bytes (%s)\n' "$total" "$(dholbeat_human_bytes "$total")"
  printf 'configured bound: %s bytes (%s)\n' "$MAX_CACHE_BYTES" "$(dholbeat_human_bytes "$MAX_CACHE_BYTES")"
  if [ -n "$builders" ]; then
    printf 'build cache: leftover dedicated builder(s):\n%s\n' "$builders" >&2
    return 1
  fi
  printf 'build cache: no dedicated builders remain\n'
  if [ "$total" -gt "$MAX_CACHE_BYTES" ]; then
    printf 'status: over bound; run guarded cleanup\n' >&2
    return 1
  fi
  printf 'status: within bound\n'
}

cache_cleanup() {
  [ "${1:-}" = "--confirm" ] || dholbeat_die "cache cleanup requires --confirm dholbeat-controller"
  [ "${2:-}" = "dholbeat-controller" ] || dholbeat_die "confirmation must be exactly: dholbeat-controller"
  [ "$#" -eq 2 ] || dholbeat_die "unexpected cache cleanup arguments"
  dholbeat_require_command docker

  local builder
  while IFS= read -r builder; do
    [ -n "$builder" ] || continue
    if [ -n "$(docker ps -q --filter "label=com.docker.buildx.builder=$builder")" ]; then
      dholbeat_die "refusing to remove a running controller builder: $builder"
    fi
    docker buildx rm "$builder" >/dev/null
    printf 'removed stopped dedicated builder %s\n' "$builder"
  done <<EOF
$(project_builder_names)
EOF

  local image_id
  local removed=0
  while IFS= read -r image_id; do
    [ -n "$image_id" ] || continue
    if [ -n "$(docker ps -aq --filter "ancestor=$image_id")" ]; then
      dholbeat_die "refusing to remove controller image used by a container: $image_id"
    fi
    docker image rm "$image_id" >/dev/null
    printf 'removed labelled controller image %s\n' "$image_id"
    removed=$((removed + 1))
  done <<EOF
$(image_ids)
EOF
  printf 'removed %s image(s); unrelated Docker images and builder caches were not touched\n' "$removed"
}

verify_image_label() {
  local actual
  actual="$(docker image inspect --format "{{ index .Config.Labels \"io.dholbeat.controller.lock\" }}" "$IMAGE_TAG")"
  [ "$actual" = "$LOCK_DIGEST" ] || dholbeat_die "controller image label does not match source lock"
}

build_image() {
  dholbeat_require_command docker
  docker buildx version >/dev/null 2>&1 || dholbeat_die "Docker buildx is required to build the controller"

  local platform
  platform="$(host_platform)"
  ACTIVE_BUILDER="dholbeat-controller-${LOCK_DIGEST:0:10}-$$"
  docker buildx create \
    --name "$ACTIVE_BUILDER" \
    --driver docker-container \
    --driver-opt "image=$BUILDKIT_IMAGE" >/dev/null
  docker buildx inspect --bootstrap "$ACTIVE_BUILDER" >/dev/null
  docker buildx build \
    --builder "$ACTIVE_BUILDER" \
    --platform "$platform" \
    --load \
    --no-cache \
    --build-arg "CONTROLLER_LOCK_DIGEST=$LOCK_DIGEST" \
    --file "$REPO_ROOT/infra/controller/Containerfile" \
    --tag "$IMAGE_TAG" \
    "$REPO_ROOT"
  finish_builder
  verify_image_label
  cache_size
}

ensure_image() {
  dholbeat_require_command docker
  if docker image inspect "$IMAGE_TAG" >/dev/null 2>&1; then
    verify_image_label
  else
    build_image
  fi
}

controller_image_id() {
  docker image inspect --format '{{.Id}}' "$IMAGE_TAG"
}

run_controller() {
  ensure_image
  local image_id
  image_id="$(controller_image_id)"
  docker run --rm \
    --read-only \
    --network none \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --label "${CACHE_LABEL}=${CACHE_VALUE}" \
    --env DHOLBEAT_IN_CONTROLLER=1 \
    --env REPO_ROOT=/workspace \
    --env SOPS_AGE_KEY \
    --env GITHUB_ACTIONS \
    --env GITHUB_EVENT_NAME \
    --env GITHUB_BASE_REF \
    --env GITHUB_HEAD_REF \
    --tmpfs /tmp:rw,nosuid,nodev,size=536870912 \
    --volume "$REPO_ROOT:/workspace:ro" \
    --workdir /workspace \
    "$image_id" "$@"
}

run_ssh_controller() {
  local known_hosts_relative="$1"
  local identity_path="$2"
  local admin_identity_path="$3"
  local inputs_path="$4"
  shift 4
  [ "$#" -gt 0 ] || dholbeat_die "exec-ssh requires a command"
  case "$known_hosts_relative" in
    .artifacts/*) ;;
    *) dholbeat_die "exec-ssh known-hosts must be a relative .artifacts/ path" ;;
  esac
  case "/$known_hosts_relative/" in
    */../*|*/./*) dholbeat_die "exec-ssh known-hosts path must not contain dot segments" ;;
  esac

  local resolved_identity=""
  local resolved_admin_identity=""
  local candidate
  for candidate in identity admin_identity; do
    local raw=""
    case "$candidate" in
      identity) raw="$identity_path" ;;
      admin_identity) raw="$admin_identity_path" ;;
    esac
    [ -n "$raw" ] || continue
    # Resolve symlinked parents before comparing, so a relative path or a
    # symlinked directory cannot smuggle repository-internal key material in.
    local canonical
    canonical="$(dholbeat_canonical_path "$raw")"
    case "$canonical" in
      "$REPO_ROOT"|"$REPO_ROOT"/*)
        dholbeat_die "exec-ssh refuses an identity file inside the repository"
        ;;
    esac
    [ ! -L "$raw" ] || dholbeat_die "exec-ssh refuses a symlinked identity file"
    [ -f "$raw" ] || dholbeat_die "exec-ssh identity file is unavailable"
    [ -r "$raw" ] || dholbeat_die "exec-ssh identity file is unreadable"
    case "$candidate" in
      identity) resolved_identity="$canonical" ;;
      admin_identity) resolved_admin_identity="$canonical" ;;
    esac
  done

  local known_hosts_path="$REPO_ROOT/$known_hosts_relative"
  [ -f "$known_hosts_path" ] || dholbeat_die "exec-ssh known-hosts file is unavailable"
  [ ! -L "$known_hosts_path" ] || dholbeat_die "exec-ssh refuses a symlinked known-hosts file"
  [ -r "$known_hosts_path" ] || dholbeat_die "exec-ssh known-hosts file is unreadable"
  [ -s "$known_hosts_path" ] || dholbeat_die "exec-ssh refuses an empty known-hosts file"

  if [ -n "$inputs_path" ]; then
    [ -d "$inputs_path" ] || dholbeat_die "exec-ssh inputs path must be an existing directory"
    [ ! -L "$inputs_path" ] || dholbeat_die "exec-ssh refuses a symlinked inputs directory"
  fi

  ensure_image
  local image_id
  image_id="$(controller_image_id)"
  NETWORKED_HOME="$(mktemp -d "${TMPDIR:-/tmp}/dholbeat-controller-home.XXXXXX")"
  chmod 0700 "$NETWORKED_HOME"
  mkdir "$NETWORKED_HOME/.ssh"
  chmod 0700 "$NETWORKED_HOME/.ssh"
  touch "$NETWORKED_HOME/.ssh/config"
  chmod 0600 "$NETWORKED_HOME/.ssh/config"
  cp -- "$known_hosts_path" "$NETWORKED_HOME/.ssh/known_hosts"
  chmod 0600 "$NETWORKED_HOME/.ssh/known_hosts"
  local controller_uid
  local controller_gid
  controller_uid="$(id -u)"
  controller_gid="$(id -g)"
  printf 'controller:x:%s:%s:Dholbeat controller:/tmp/controller-home:/usr/sbin/nologin\n' \
    "$controller_uid" "$controller_gid" >"$NETWORKED_HOME/passwd"
  printf 'controller:x:%s:\n' "$controller_gid" >"$NETWORKED_HOME/group"
  chmod 0600 "$NETWORKED_HOME/passwd" "$NETWORKED_HOME/group"

  local identity_mount=()
  if [ -n "$resolved_identity" ]; then
    cp -- "$resolved_identity" "$NETWORKED_HOME/.ssh/id_target"
    chmod 0600 "$NETWORKED_HOME/.ssh/id_target"
    identity_mount=(--env DHOLBEAT_SSH_IDENTITY=/tmp/controller-home/.ssh/id_target)
  fi
  if [ -n "$resolved_admin_identity" ]; then
    cp -- "$resolved_admin_identity" "$NETWORKED_HOME/.ssh/id_admin"
    chmod 0600 "$NETWORKED_HOME/.ssh/id_admin"
  fi
  local inputs_mount=()
  if [ -n "$inputs_path" ]; then
    inputs_mount=(--volume "$inputs_path:/tmp/controller-inputs:ro")
  fi

  docker run --rm \
    --read-only \
    --network bridge \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --user "$controller_uid:$controller_gid" \
    --label "${CACHE_LABEL}=${CACHE_VALUE}" \
    --env ANSIBLE_CONFIG=/workspace/infra/ansible.cfg \
    --env ANSIBLE_HOST_KEY_CHECKING=True \
    --env DHOLBEAT_IN_CONTROLLER=1 \
    --env REPO_ROOT=/workspace \
    --env SOPS_AGE_KEY \
    --tmpfs /tmp:rw,nosuid,nodev,size=536870912 \
    --volume "$REPO_ROOT:/workspace:ro" \
    --volume "$NETWORKED_HOME:/tmp/controller-home:rw" \
    --volume "$NETWORKED_HOME/passwd:/etc/passwd:ro" \
    --volume "$NETWORKED_HOME/group:/etc/group:ro" \
    ${identity_mount[@]+"${identity_mount[@]}"} \
    ${inputs_mount[@]+"${inputs_mount[@]}"} \
    --workdir /workspace \
    "$image_id" "$@"
}

case "${1:-help}" in
  -h|--help|help)
    usage
    ;;
  build)
    [ "$#" -eq 1 ] || dholbeat_die "build accepts no arguments"
    build_image
    ;;
  versions)
    [ "$#" -eq 1 ] || dholbeat_die "versions accepts no arguments"
    run_controller versions
    ;;
  exec)
    shift
    [ "$#" -gt 0 ] || dholbeat_die "exec requires a command"
    run_controller "$@"
    ;;
  exec-ssh)
    shift
    known_hosts_relative=""
    ssh_identity_path=""
    ssh_admin_identity_path=""
    ssh_inputs_path=""
    ssh_target_class=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --known-hosts)
          [ "$#" -ge 2 ] || dholbeat_die "--known-hosts requires .artifacts/<file>"
          known_hosts_relative="$2"
          shift 2
          ;;
        --identity)
          [ "$#" -ge 2 ] || dholbeat_die "--identity requires a path"
          ssh_identity_path="$2"
          shift 2
          ;;
        --admin-identity)
          [ "$#" -ge 2 ] || dholbeat_die "--admin-identity requires a path"
          ssh_admin_identity_path="$2"
          shift 2
          ;;
        --inputs)
          [ "$#" -ge 2 ] || dholbeat_die "--inputs requires a directory"
          ssh_inputs_path="$2"
          shift 2
          ;;
        --confirm)
          [ "$#" -ge 2 ] || dholbeat_die "--confirm requires disposable-host or production-host"
          ssh_target_class="$2"
          shift 2
          break
          ;;
        --*) dholbeat_die "unexpected exec-ssh argument: $1" ;;
        *) dholbeat_die "exec-ssh requires --confirm disposable-host or --confirm production-host before the command" ;;
      esac
    done
    [ -n "$known_hosts_relative" ] || dholbeat_die "exec-ssh requires --known-hosts .artifacts/<file>"
    case "$ssh_target_class" in
      disposable-host|production-host) ;;
      *) dholbeat_die "exec-ssh requires --confirm disposable-host or --confirm production-host" ;;
    esac
    run_ssh_controller "$known_hosts_relative" "$ssh_identity_path" \
      "$ssh_admin_identity_path" "$ssh_inputs_path" "$@"
    ;;
  digest)
    [ "$#" -eq 1 ] || dholbeat_die "digest accepts no arguments"
    ensure_image
    printf 'source_lock_sha256=%s\n' "$LOCK_DIGEST"
    printf 'image_id=%s\n' "$(controller_image_id)"
    printf 'platform=%s\n' "$(host_platform)"
    ;;
  cache)
    case "${2:-}" in
      size)
        [ "$#" -eq 2 ] || dholbeat_die "cache size accepts no arguments"
        cache_size
        ;;
      cleanup)
        shift 2
        cache_cleanup "$@"
        ;;
      *) dholbeat_die "cache requires size or cleanup" ;;
    esac
    ;;
  *)
    dholbeat_die "unknown controller command: $1"
    ;;
esac
