{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/prompt.schema.json",
  "title": "Brand-agnostic prompt manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_id", "scope", "stage", "template", "input_keys", "output_contract", "prohibited_outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "prompt_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "scope": {"const": "generic"},
    "stage": {"enum": ["research", "ideation", "caption", "visual", "metrics"]},
    "template": {"type": "string", "minLength": 1},
    "input_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
    "output_contract": {"type": "string", "minLength": 1},
    "prohibited_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "AI avatar testimonials"},
      "uniqueItems": true
    }
  }
}
