{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/prompt.schema.json",
  "title": "Brand-agnostic prompt manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "scope",
    "stage",
    "template",
    "input_keys",
    "output_contract",
    "output_schema",
    "prohibited_outputs",
    "model",
    "max_tokens",
    "max_cost_usd",
    "retry_policy",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "prompt_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "scope": {"const": "generic"},
    "stage": {"enum": ["research", "ideation", "caption", "visual", "metrics"]},
    "template": {"type": "string", "minLength": 1},
    "input_keys": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "output_contract": {"type": "string", "minLength": 1},
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "required": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "array", "object", "null"]
          }
        },
        "additionalProperties": {"type": "boolean"}
      }
    },
    "prohibited_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "AI avatar testimonials"},
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "capability"],
      "properties": {
        "provider": {"enum": ["claude", "openai", "gemini", "fal", "stable"]},
        "model": {"type": "string", "minLength": 1},
        "capability": {"enum": ["reasoning", "vision", "drafting", "summarization"]}
      }
    },
    "max_tokens": {"type": "integer", "minimum": 1, "maximum": 4096},
    "max_cost_usd": {"type": "number", "minimum": 0, "exclusiveMinimum": 0, "maximum": 0.2},
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "backoff_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disallowed_claims",
        "required_disclosure_tags",
        "publish_policy",
        "image_text_policy"
      ],
      "properties": {
        "disallowed_claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_disclosure_tags": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "contains": {"const": "ai-generated"},
          "uniqueItems": true
        },
        "publish_policy": {
          "type": "string",
          "const": "human-approved-only"
        },
        "image_text_policy": {
          "type": "string",
          "const": "overlay-only"
        }
      }
    }
  }
}
