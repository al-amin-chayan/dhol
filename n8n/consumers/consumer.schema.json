{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dholbeat.local/v1/n8n-consumer.schema.json",
  "title": "n8n consumer manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumer_id", "project_id", "workflow_namespace", "repository", "export_path", "source_commit", "owner", "incident_contact", "alert_destination", "credential_ids", "outbound_hosts", "direct_database_access", "trigger_types", "max_execution_seconds", "expected_runs_per_day", "allowed_nodes", "denied_nodes", "data_classification", "retention", "route_ids", "commands", "activation_conditions"],
  "properties": {
    "schema_version": {"const": 1},
    "consumer_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "project_id": {"type": "string", "minLength": 1},
    "workflow_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
    "export_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "source_commit": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "incident_contact": {"type": "string", "minLength": 1},
    "alert_destination": {"type": "string", "minLength": 1},
    "credential_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "outbound_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "direct_database_access": {"const": false},
    "trigger_types": {"type": "array", "minItems": 1, "items": {"enum": ["schedule", "webhook", "manual", "event"]}, "uniqueItems": true},
    "max_execution_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "expected_runs_per_day": {"type": "integer", "minimum": 0},
    "allowed_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "denied_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "data_classification": {"enum": ["public", "internal", "confidential", "pii"]},
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["save_success", "failure_days", "binary_hours", "deletion_reconciliation"],
      "properties": {
        "save_success": {"type": "boolean"},
        "failure_days": {"type": "integer", "minimum": 1, "maximum": 14},
        "binary_hours": {"type": "integer", "minimum": 1, "maximum": 24},
        "deletion_reconciliation": {"type": "string", "minLength": 1}
      }
    },
    "route_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import", "smoke_test", "rollback", "restore"],
      "properties": {
        "import": {"type": "string", "minLength": 1},
        "smoke_test": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1},
        "restore": {"type": "string", "minLength": 1}
      }
    },
    "activation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
